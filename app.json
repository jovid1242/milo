{
  "expo": {
    "name": "Milo",
    "slug": "milo",
    "owner": "frankfrudo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "milo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.jovid.milo",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDF8"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2F6B46",
          "defaultChannel": "team-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "99ac1d65-8359-436a-a8a7-342b76710337"
      }
    }
  }
}
