# The app's backend, read at build time. Copy what you need into .env.local
# (ignored by git) and restart Metro with --clear.

# The Milo API (npm run api:dev). Without it: local mode — no sign-in, bundled course.
# The iOS Simulator reaches the Mac as localhost; a phone needs the Mac's LAN address.
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# "bundled" keeps the course from the app while accounts use the API. Default: api.
# EXPO_PUBLIC_COURSE_SOURCE=bundled
