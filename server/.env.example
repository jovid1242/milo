# Milo API — copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose up -d db). Local development credentials only.
DATABASE_URL=postgresql://milo:milo@localhost:5432/milo?schema=public

# Access tokens: a signed JWT, short-lived. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m

# Refresh tokens: opaque, stored as HMAC-SHA256 hashes keyed with this secret.
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string-32-chars
REFRESH_TOKEN_TTL=30d
# A used refresh token presented again within this window, before anything
# issued for it was used, is a retry (a lost response), not a replay.
REFRESH_TOKEN_REUSE_GRACE=30s

# Sign-up and sign-in attempts per client address and route, per minute
# (429 with Retry-After above it). Refresh and logout are not limited.
AUTH_RATE_LIMIT=20

# Comma-separated origins allowed by CORS (the mobile app needs none).
CORS_ORIGINS=
# Swagger UI at /api/docs. Defaults to on outside production.
SWAGGER_ENABLED=
# Behind a reverse proxy, trust it for the client IP (rate limiting, logs).
TRUST_PROXY=false
LOG_LEVEL=info
