{
  "name": "milo",
  "version": "1.0.0",
  "private": true,
  "description": "Milo \u2014 90 Day English Challenge (Expo, local-first).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios --go",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "content:validate": "jest --config scripts/content/jest.config.js validate-course",
    "curriculum:doc": "jest --config scripts/content/jest.config.js curriculum-doc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "assets:optimize": "node scripts/optimize-assets.mjs && node scripts/generate-asset-registry.mjs",
    "assets:check": "node scripts/optimize-assets.mjs --check",
    "assets:slice": "node scripts/slice-assets.mjs",
    "assets:registry": "node scripts/generate-asset-registry.mjs",
    "api:install": "npm --prefix server install",
    "api:dev": "npm --prefix server run start:dev",
    "api:build": "npm --prefix server run build",
    "api:start": "npm --prefix server run start",
    "api:test": "npm --prefix server test",
    "api:lint": "npm --prefix server run lint",
    "api:typecheck": "npm --prefix server run typecheck",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:deploy": "npm --prefix server run db:deploy",
    "db:status": "npm --prefix server run db:status"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.103.1",
    "expo": "~57.0.23",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.7",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "0.35.4",
    "svgo": "4.1.0",
    "typescript": "~6.0.3"
  }
}
