# What EAS Build uploads: everything git keeps (this file replaces .gitignore
# for EAS, so it repeats it — keep the two in step), minus what the app build
# never needs: the API, the store-screenshot tool, local agent settings.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by prebuild; not used while running in Expo Go)
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/ios
/android

# Metro
.metro-health-check*

# Asset pipeline scratch directories
.assets-build/
.assets-previous/

# debug
npm-debug.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase. The Android build's config: local only, served to EAS Build as a
# file variable (GOOGLE_SERVICES_JSON) — never committed.
google-services.json
# Service-account keys never live in this repository, under any name.
*firebase-adminsdk*.json
*service-account*.json
*service_account*.json

# typescript
*.tsbuildinfo

# tests
coverage/
assets-original/

# Not part of the app build
server/
store-screenshots/
.claude/
